{
  "description": "Boeing 737 MAX 8 Cockpit Input Event Reference — derived from B737_MAX8_Cockpit_Behavior.xml",
  "version": "2.0.0",
  "usage": "Use fire_input_event(eventName, value?) or list_input_events(filter) to interact with these controls",
  "panels": {
    "MCP_AUTOPILOT": {
      "description": "Mode Control Panel (Glareshield) — FCC autopilot controls",
      "prefix": "FCC_",
      "controls": {
        "FCC_N1": { "type": "button", "description": "N1 mode" },
        "FCC_SPEED": { "type": "button", "description": "Speed (IAS/Mach) mode", "alias": "FCC_AP_SPD" },
        "FCC_VNAV": { "type": "button", "description": "VNAV mode", "alias": "FCC_AP_VNAV" },
        "FCC_LNAV": { "type": "button", "description": "LNAV mode", "alias": "FCC_AP_LNAV" },
        "FCC_LVL_CHG": { "type": "button", "description": "Level Change mode", "alias": "FCC_AP_FLCH" },
        "FCC_VOR_LOC": { "type": "button", "description": "VOR/LOC mode" },
        "FCC_APP": { "type": "button", "description": "Approach mode" },
        "FCC_ALT_HLD": { "type": "button", "description": "Altitude Hold" },
        "FCC_HDG_SEL": { "type": "button", "description": "Heading Select" },
        "FCC_VS": { "type": "button", "description": "Vertical Speed mode" },
        "FCC_CMD_1": { "type": "button", "description": "CMD A autopilot engage" },
        "FCC_CMD_2": { "type": "button", "description": "CMD B autopilot engage" },
        "FCC_CWS_1": { "type": "button", "description": "CWS A" },
        "FCC_CWS_2": { "type": "button", "description": "CWS B" },
        "FCC_FD_1": { "type": "switch", "description": "Flight Director 1 (Captain)", "values": "0=OFF, 1=ON" },
        "FCC_FD_2": { "type": "switch", "description": "Flight Director 2 (F/O)", "values": "0=OFF, 1=ON" },
        "FCC_AUTOTHROTTLE": { "type": "switch", "description": "Autothrottle arm", "values": "0=OFF, 1=ARMED" },
        "FCC_DISENGAGE": { "type": "button", "description": "AP disengage bar" },
        "FCC_CHANGEOVER": { "type": "button", "description": "IAS/MACH changeover" },
        "FCC_SPEED_INTERVENTION": { "type": "button", "description": "Speed intervention" },
        "FCC_ALTITUDE_INTERVENTION": { "type": "button", "description": "Altitude intervention" },
        "FCC_SPEED_SEL": { "type": "knob_infinite", "description": "Speed selector knob", "note": "Use INC/DEC or set value directly" },
        "FCC_HEADING_SEL": { "type": "knob_infinite", "description": "Heading selector knob" },
        "FCC_ALTITUDE_SEL": { "type": "knob_infinite", "description": "Altitude selector knob", "note": "Set value=altitude in feet (e.g. 30000)" },
        "FCC_VERTICAL_SPEED_SEL": { "type": "knob_infinite", "description": "V/S thumb wheel" },
        "FCC_BANK_ANGLE_SEL": { "type": "knob", "description": "Bank angle limit selector", "values": "0=10°, 1=15°, 2=20°, 3=25°, 4=30°" },
        "FCC_COURSE_1": { "type": "knob_infinite", "description": "Course selector 1 (Captain)" },
        "FCC_COURSE_2": { "type": "knob_infinite", "description": "Course selector 2 (F/O)" }
      }
    },
    "EFIS": {
      "description": "EFIS controls (Glareshield) — map mode, range, mins, baro",
      "prefix": "EFIS_",
      "controls": {
        "EFIS_WXR": { "type": "button", "description": "Weather radar overlay toggle" },
        "EFIS_STA": { "type": "button", "description": "Station overlay toggle" },
        "EFIS_WPT": { "type": "button", "description": "Waypoint overlay toggle" },
        "EFIS_ARPT": { "type": "button", "description": "Airport overlay toggle" },
        "EFIS_DATA": { "type": "button", "description": "Data overlay toggle" },
        "EFIS_POS": { "type": "button", "description": "Position overlay toggle" },
        "EFIS_TERR": { "type": "button", "description": "Terrain overlay toggle" },
        "EFIS_VSD": { "type": "button", "description": "Vertical situation display toggle" },
        "EFIS_FPV": { "type": "button", "description": "Flight path vector toggle" },
        "EFIS_MTRS": { "type": "button", "description": "Meters toggle" },
        "EFIS_CTR": { "type": "button", "description": "Center map" },
        "EFIS_TFC": { "type": "button", "description": "Traffic toggle" },
        "EFIS_Mode": { "type": "knob", "description": "Map mode selector", "values": "0=APP, 1=VOR, 2=MAP, 3=PLN" },
        "EFIS_Range": { "type": "knob", "description": "Map range selector", "values": "0-7 (5,10,20,40,80,160,320,640 NM)" },
        "EFIS_Mins_Ref": { "type": "knob", "description": "Mins reference", "values": "0=RADIO, 1=BARO" },
