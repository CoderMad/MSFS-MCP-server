        "ENGINE_IGNITION_2": { "type": "knob", "description": "Engine 2 start selector" },
        "ENGINE_IGNITION_SELECT": { "type": "switch", "description": "Ignition select", "values": "0=L, 1=BOTH, 2=R" },
        "ENGINE_APU": { "type": "switch", "description": "APU master", "values": "0=START, 1=ON, 2=OFF" }
