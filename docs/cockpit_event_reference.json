        "EFIS_BARO_UNIT": { "type": "knob", "description": "Baro units", "values": "0=IN, 1=HPA" },
        "EFIS_VOR_ADF_1": { "type": "switch", "description": "VOR/ADF selector 1", "values": "0=ADF, 1=OFF, 2=VOR" },
        "EFIS_VOR_ADF_2": { "type": "switch", "description": "VOR/ADF selector 2", "values": "0=ADF, 1=OFF, 2=VOR" }
      }
    },
    "ANNUNCIATION": {
      "description": "Glareshield annunciation buttons",
      "controls": {
        "ANNUNCIATION_FIRE_WARN": { "type": "button", "description": "Fire warning reset" },
        "ANNUNCIATION_MASTER_CAUTION": { "type": "button", "description": "Master caution acknowledge" },
        "ANNUNCIATION_RECALL": { "type": "button", "description": "System recall" },
        "ANNUNCIATION_AP_DISENGAGE": { "type": "button", "description": "AP disengage light reset" },
        "ANNUNCIATION_AT_DISENGAGE": { "type": "button", "description": "AT disengage light reset" },
