        "PRESSURIZATION_APU_BLEED": { "type": "switch", "description": "APU bleed" },
        "PRESSURIZATION_PRESS_SELEC": { "type": "knob", "description": "Pressurization mode", "values": "0=AUTO, 1=ALTN, 2=MAN" },
        "PRESSURIZATION_LAND_ALT": { "type": "knob_infinite", "description": "Landing altitude selector" },
        "PRESSURIZATION_FLT_ALT": { "type": "knob_infinite", "description": "Flight altitude selector" }
