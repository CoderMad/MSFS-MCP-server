    "FMC_CDU": {
      "description": "FMC CDU keys — use press_cdu_key or type_text instead of fire_input_event",
      "prefix": "FMC_EV_",
      "note": "CDU keys are best accessed via press_cdu_key(key) and type_text(text) tools. The input events follow the pattern FMC_EV_{KEY}_{CDU_NUM} (e.g. FMC_EV_L1_1, FMC_EV_INIT_1)",
      "keys": ["A-Z", "0-9", "L1-L6", "R1-R6", "INIT", "RTE", "DEPARR", "LEGS", "HOLD", "PROG", "EXEC", "MENU", "NAVRAD", "VNAV", "FIX", "FMCCOM", "ATC", "N1LIMIT", "PREVPAGE", "NEXTPAGE", "CLR", "DEL", "SP", "DIV", "DOT", "PLUSMINUS"]
    }
