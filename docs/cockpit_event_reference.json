      "description": "Overhead panel — electrical system",
      "prefix": "ELECTRICAL_",
      "controls": {
        "ELECTRICAL_BATTERY": { "type": "switch", "description": "Battery switch", "values": "0=ON, 1=OFF" },
        "ELECTRICAL_GENERATOR_1": { "type": "switch", "description": "Generator 1", "values": "0=ON, 1=Neutral, 2=OFF" },
        "ELECTRICAL_GENERATOR_2": { "type": "switch", "description": "Generator 2" },
        "ELECTRICAL_APU_GENERATOR_1": { "type": "switch", "description": "APU Generator 1" },
        "ELECTRICAL_APU_GENERATOR_2": { "type": "switch", "description": "APU Generator 2" },
